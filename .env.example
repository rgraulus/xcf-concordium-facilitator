# --- JWT signing (M1) ---
JWS_PRIVATE_KEY_BASE64=<base64-of-ed25519-pkcs8-private-der>
JWS_KEY_ID=kid-dev-1

# --- Concordium gRPC (M2 wiring; testnet defaults from docs) ---
CONCORDIUM_NETWORK=testnet
CONCORDIUM_GRPC_HOST=grpc.testnet.concordium.com
CONCORDIUM_GRPC_PORT=20000
CONCORDIUM_GRPC_TLS=true
CONCORDIUM_GRPC_CA_FILE=

# --- Wallet-proxy (M3 account / PLT indexer) ---
# Base URL of the Concordium wallet proxy instance XCF should talk to.
# For local dev we assume the official image is running on port 3000.
WALLET_PROXY_BASE_URL=http://localhost:3000

# Optional tuning for XCF -> wallet-proxy HTTP calls.
# These defaults are safe; override in your real .env if needed.
WALLET_PROXY_TIMEOUT_MS=15000
WALLET_PROXY_MAX_RETRIES=2
