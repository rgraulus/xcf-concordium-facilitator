{
  "$id": "https://xcf/schemas/receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "v",
    "challenge_nonce",
    "network",
    "asset",
    "amount",
    "from",
    "to",
    "tx_hash",
    "block_hash",
    "finalized_at",
    "compliance",
    "facilitator_sig",
    "facilitator_key_id"
  ],
  "properties": {
    "v": { "const": "1" },
    "challenge_nonce": { "type": "string", "minLength": 1 },
    "network": { "type": "string", "pattern": "^concordium:(testnet|mainnet)$" },
    "asset": {
      "type": "object",
      "required": ["type", "tokenId", "decimals"],
      "properties": {
        "type": { "const": "PLT" },
        "tokenId": { "type": "string", "minLength": 1 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 18 }
      },
      "additionalProperties": false
    },
    "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,18})?$" },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "tx_hash": { "type": "string", "minLength": 1 },
    "block_hash": { "type": "string", "minLength": 1 },
    "finalized_at": { "type": "string", "format": "date-time" },
    "compliance": { "type": "object" },
    "facilitator_sig": { "type": "string", "minLength": 1 },
    "facilitator_key_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
