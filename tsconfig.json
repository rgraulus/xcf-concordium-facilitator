{
  "compilerOptions": {
    /* Language and emit */
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "moduleResolution": "node",

    /* Paths */
    "rootDir": "src",
    "outDir": "dist",

    /* Interop & modules */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Strictness */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Node types */
    "types": ["node"]
  },

  /* Explicit extra files to include in the program */
  "files": [
    "concordium-web-sdk-nodejs.d.ts"
  ],

  /* Main source tree */
  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "dist",
    "node_modules",
    "src/tools/**/*"
  ]
}
