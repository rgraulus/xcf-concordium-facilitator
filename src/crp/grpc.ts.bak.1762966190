// src/crp/grpc.ts (drop-in)
import { GrpcTransport } from "@protobuf-ts/grpc-transport";
import * as grpcjs from "@grpc/grpc-js";
import { QueriesClient } from "@concordium/common-sdk/lib/GRPCClient";
import { ensureMergeOptions } from "../crp/transport-shim";

// ---------- Config ----------
type GrpcCfg = {
  host: string;         // e.g., grpc.testnet.concordium.com
  port: number;         // e.g., 20000
  tls: boolean;         // true for TLS
  network: "testnet" | "mainnet" | string;
  caFile?: string | null;
};

export function getGrpcConfig(): GrpcCfg {
  const host = process.env.CONCORDIUM_GRPC_HOST || "127.0.0.1";
  const port = Number(process.env.CONCORDIUM_GRPC_PORT || "20000");
  const tls = String(process.env.CONCORDIUM_GRPC_TLS || "false").toLowerCase() === "true";
  const network = (process.env.CONCORDIUM_NETWORK || "testnet") as GrpcCfg["network"];
  const caFile = process.env.CONCORDIUM_GRPC_CA || null;
  return { host, port, tls, network, caFile };
}

// ---------- Diagnostics ----------
export async function getTransportDiagnostics() {
  const d: any = {
    hasMergeOptions: true,
    transportCtor: "GrpcTransport",
    grpcJs: { hasCredentials: !!grpcjs.credentials },
  };
  return d;
}

// ---------- Transport / Client ----------
function makeTransport(cfg: GrpcCfg): GrpcTransport {
  const target = `${cfg.host}:${cfg.port}`;
  const creds = cfg.tls
    ? grpcjs.credentials.createSsl()          // public node, system CAs OK
    : grpcjs.credentials.createInsecure();

  // as per @protobuf-ts/grpc-transport options
  const t = new GrpcTransport({
    host: target,
    channelCredentials: creds,
  });
  return ensureMergeOptions(t);
}

let _queriesClient: QueriesClient | null = null;
export function getQueriesClient(): QueriesClient {
  if (_queriesClient) return _queriesClient;
  const transport = makeTransport(getGrpcConfig());
  _queriesClient = new QueriesClient(transport as any);
  return _queriesClient!;
}

// ---------- Helpers (bytes/hex) ----------
const asBytes = (b: any): Uint8Array | undefined => {
  if (!b) return undefined;
  if (b instanceof Uint8Array) return b;
  if (b?.value instanceof Uint8Array) return b.value;
  if (Array.isArray(b)) return Uint8Array.from(b);
  return undefined;
};

const toHex = (u?: Uint8Array | string): string =>
  typeof u === "string" ? u : (u ? Buffer.from(u).toString("hex") : "");

// ---------- Public API ----------
export async function getConsensusSummary() {
  const client = getQueriesClient();
  const info: any = await client.getConsensusInfo({});

  const bestHex = toHex(asBytes(info.bestBlock));
  const finalizedHex = toHex(asBytes(info.lastFinalizedBlock));

  return {
    ok: true,
    consensus: { genesisIndex: info?.genesisIndex ?? null },
    blocks: {
      best: { hash: bestHex, height: "" },        // height omitted to avoid BigInt serialization
      finalized: { hash: finalizedHex, height: "" }
    },
    network: getGrpcConfig().network,
  };
}

// Conservative address validator (keeps earlier imports happy)
export function isProbablyAccountAddress(s: string): boolean {
  // Concordium account addresses typically start with '3' (base58) or 'ccd1' (bech32),
  // bech32 length ~ 55, base58 ~ 50; we only do a soft gate here.
  if (typeof s !== "string" || s.length < 20) return false;
  if (s.startsWith("ccd1")) return true;
  if (/^[1-9A-HJ-NP-Za-km-z]+$/.test(s) && s.length >= 30) return true; // base58-ish
  return false;
}

// Backward-compatible alias if older code imported validateAccountAddress
export const validateAccountAddress = isProbablyAccountAddress;
